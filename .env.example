# ============================================================================
# Data directory
# ============================================================================
# REQUIRED: Absolute path on the host (or on a mounted network share) to the
# directory that contains the KIAS DBF data. That folder must directly hold
# the Daten/, Update/, and Formulare/ subdirectories.
#
# Linux example:        KIAS_DATA_DIR=/srv/kias
# macOS example:        KIAS_DATA_DIR=/Users/me/Kias
# Windows example:      KIAS_DATA_DIR=C:/Users/me/Kias
# WSL2 path example:    KIAS_DATA_DIR=/mnt/c/Users/me/Kias
# SMB share (mounted):  KIAS_DATA_DIR=/mnt/kias-share
#
# (For a Windows SMB share, mount it on the host first with `net use` or
# /etc/fstab; then point KIAS_DATA_DIR at the mountpoint.)
#
# Docker uses this value for the bind mount and then tells the app
# KIAS_ROOT=/data. When you start the server directly (`npm start`),
# there is no mount, so the app reads this file itself and falls back to
# KIAS_DATA_DIR as its data root. Set KIAS_ROOT explicitly if the two
# should differ. Real environment variables always win over this file.
KIAS_DATA_DIR=./data

# ============================================================================
# Ports der beiden Dienste
# ============================================================================
# Compose startet zwei Container aus einem Image:
#   neo-kias    die React-Oberfläche (Einstieg für Menschen)
#   rest-kias   die REST-Schnittstelle (Einstieg für die App athena-KIAS)
# Innerhalb der Container lauscht beides auf 5175, nach außen sind es zwei
# verschiedene Ports.

# Port der Oberfläche auf dem Host.
HOST_PORT=5175

# Port der REST-Schnittstelle auf dem Host. Diese Adresse trägt man in
# athena-KIAS ein, zum Beispiel http://192.168.1.42:5176.
API_PORT=5176

# Port der Verwaltung auf dem Host.
ADMIN_PORT=5177

# Adresse, an die die Oberfläche ihre /api-Aufrufe weiterreicht. Der
# Vorgabewert ist der Dienstname im Compose-Netz; nur ändern, wenn die
# Schnittstelle woanders läuft.
KIAS_API_URL=http://rest-kias:5175

# Welche Hälfte ein Prozess bedient. Compose setzt das je Container
# selbst; hier steht es nur für den Fall, dass jemand die Dienste von
# Hand startet.
#   all   Oberfläche und Schnittstelle in einem Prozess (Vorgabe, npm start)
#   api   nur die REST-Schnittstelle, liest die Daten
#   web   nur die Suchoberfläche, reicht /api an KIAS_API_URL weiter
#   admin nur die Verwaltung, ebenfalls weiterreichend
KIAS_ROLE=all

# ============================================================================
# Verwaltung
# ============================================================================
# Die Verwaltung ist eine eigene Oberfläche (Vue) unter ADMIN_PORT. Von
# dort wird der Datenpfad gesetzt und neu eingelesen; in der Suche gibt es
# den Knopf „neu einlesen" nicht mehr.
#
# Ein und aus geschieht über zwei Zeilen, die zusammengehören:
#
#   COMPOSE_PROFILES=admin   startet die Container admin-kias und kias-db
#   KIAS_ADMIN=true          schaltet /api/admin/* in rest-kias frei
#
# Sollen zusätzlich die Protokolle gesammelt und in Grafana sichtbar
# sein, kommt das Profil "logs" dazu: COMPOSE_PROFILES=admin,logs. Siehe
# den eigenen Abschnitt weiter unten.
#
# Zum Abschalten beide umstellen: COMPOSE_PROFILES leer lassen und
# KIAS_ADMIN=false. Dann gibt es keine Verwaltung, keine Datenbank und
# keinen Weg mehr, die Daten neu einzulesen, ohne den Dienst neu zu
# starten. Bleibt nur eines von beiden stehen, läuft entweder ein
# Container ohne Gegenstück oder eine Oberfläche vor verschlossener Tür.
COMPOSE_PROFILES=admin
KIAS_ADMIN=true

# Passwort der Verwaltung. Der Benutzername ist immer "admin". Ohne
# Angabe gilt "admin" auch als Passwort; der Start warnt dann im Log und
# die Oberfläche zeigt einen Hinweis. Auf einem Server, den mehrere
# Personen erreichen, gehört hier etwas Eigenes hin.
#
# Dasselbe Passwort gilt für Grafana, falls das Profil "logs" läuft.
KIAS_ADMIN_PASSWORD=

# ============================================================================
# Protokolle: Loki und Grafana (optional)
# ============================================================================
# Mit COMPOSE_PROFILES=admin,logs kommen drei Container dazu: kias-loki
# sammelt die Protokolle, kias-alloy liefert sie dorthin, kias-grafana
# zeigt sie an. Zusammen etwa 300 MB Arbeitsspeicher.
#
# Angemeldet wird sich mit admin und KIAS_ADMIN_PASSWORD von oben. Eine
# fertige Übersicht ist dabei: Ladeläufe, Fehler, Zugriffe auf die
# Verwaltung.
#
# Port der Oberfläche.
GRAFANA_PORT=5178

# Wie lange die Protokolle aufbewahrt werden. 720h sind 30 Tage.
LOKI_RETENTION=720h

# Woher Alloy die Zeilen nimmt:
#
#   config.alloy         über den Docker-Socket. Fängt auch Postgres und
#                        das, was ein Container beim Abstürzen ausgibt.
#   config-files.alloy   aus den rotierenden Dateien unter KIAS_LOG_DIR.
#                        Für Umgebungen ohne Zugriff auf den Socket.
ALLOY_CONFIG=config.alloy

# Wie lange eine Anmeldung an der Verwaltung gilt, in Stunden.
KIAS_ADMIN_SESSION_HOURS=8

# Passwort der Einstellungsdatenbank. Sie ist nach außen nicht geöffnet,
# nur rest-kias spricht mit ihr über das Compose-Netz.
POSTGRES_PASSWORD=kias

# Vollständige Adresse der Einstellungsdatenbank. Ohne Angabe wird sie
# aus POSTGRES_PASSWORD und dem Dienstnamen kias-db gebildet. Eigene
# Angabe nur nötig, wenn ein bereits vorhandener Postgres benutzt werden
# soll. Leer heißt: keine Datenbank, es gilt allein KIAS_DATA_DIR und die
# Verwaltung kann den Pfad nicht speichern.
DATABASE_URL=

# Optional: container timezone (affects log timestamps and date display).
TZ=Europe/Berlin

# ============================================================================
# Car model photos (optional)
# ============================================================================

# Master switch for the photo / silhouette area on the Fahrzeuge cards.
# Off by default, cards show only the count, model name, and the "Generationen
# ansehen →" footer. Set to "true" to enable the image area.
#
# When enabled:
#   - If a matching photo exists in KIAS_CAR_IMAGES_DIR, it is shown.
#   - If not, a generic SVG silhouette of the body type is shown as a fallback.
KIAS_SHOW_CAR_IMAGES=false

# Directory on the host containing photos for the Fahrzeuge card view.
#
# Filename rule: <model-slug>.<png|jpg|jpeg|webp|svg|avif>
#   - lowercase, ASCII only
#   - spaces -> "-"
#   - special chars stripped (ä→a, ö→o, ü→u, ß→ss, "/", "." etc. → "-")
#
# Examples:
#   mondeo.png            transit-connect.png       mustang-mach-e.png
#   fiesta.png            transit-courier.png       focus-electric.png
#   c-max.png             transit-custom-phev.png   ford-gt.png
#   ka-plus.png           ford-gt.png               s-max.webp
#
# Use PNGs with transparent background for the best card look. If no file
# matches a given model line, the UI falls back to a generic SVG silhouette.
KIAS_CAR_IMAGES_DIR=./car-images

# ============================================================================
# Logging
# ============================================================================

# Directory on the host where rotated log files should be written.
# Must be writable by uid 1000 (the container's "node" user).
# Example:
#   mkdir -p ./logs && sudo chown 1000:1000 ./logs   # Linux
KIAS_LOG_DIR=./logs

# Minimum log level. One of: fatal, error, warn, info, debug, trace.
# - info  (default) logs every HTTP request + startup/reload events
# - debug additionally logs the search filters and resolved bulletin codes
# - warn  reduces noise to 4xx/5xx responses and operational issues
LOG_LEVEL=info

# Log rotation thresholds. A new file is started whenever EITHER condition
# is met (size OR frequency), so big traffic days don't blow up one file.
# IMPORTANT: docker-compose does NOT strip inline "#" comments from .env
# values, keep comments on their own lines, never on the value line.

# Max file size before rotation (e.g. 5m, 100m, 1k, 1024b).
LOG_MAX_SIZE=10m

# Rotation frequency: "daily", "hourly", or a number of milliseconds.
LOG_FREQUENCY=daily

# How many historic files to keep. Older ones are deleted automatically.
LOG_MAX_FILES=14

# Set to "false" to suppress stdout (and thus `docker logs`) once file
# logging is on. Default keeps both for easier debugging.
LOG_STDOUT=true

# ----------------------------------------------------------------------------
# Search tuning
# ----------------------------------------------------------------------------
# Precompute one lowercased copy of each row's text fields at load time.
# Makes the first query of a filter combination roughly 2-4x faster, at a
# cost of about 100 MB of heap. Set to "false" on RAM-tight hosts; the
# search engine then rescans the fields per query as before.
KIAS_SEARCH_BLOBS=true

# How many filter combinations to keep memoized. Repeats of a query and
# paging through its results are then served from memory (sub-millisecond).
# The cache is dropped automatically whenever the data is reloaded.
KIAS_SEARCH_CACHE=50

# Track what every KIAS update file added, changed, renumbered and
# withdrew, and expose it as the "Änderungen" page plus a note when a
# search hits a code that no longer exists (e.g. "25SC4 was withdrawn with
# update 007/2026"). Costs about half a second of load time and a few
# hundred KB of memory. Set to "false" to drop the feature: the page and
# the footer link disappear and deleted bulletins leave no trace.
KIAS_HISTORY=true

# Swagger UI for the JSON API under /api/docs, served from the local
# swagger-ui-dist package (no CDN, works without internet access). The
# spec itself is at /api/docs/openapi.json. Set to "false" to switch the
# documentation off; the endpoint then answers 404.
KIAS_API_DOCS=true

# Name, unter dem sich der Server in der App zeigt (/api/ping). Ohne
# Angabe wird der Rechnername verwendet. Sinnvoll, wenn in einem Betrieb
# mehrere Server laufen.
KIAS_SERVER_NAME=
